#!/bin/sh
# Pre-commit secret guard (leak-history hardening, 2026-09-04)
#
# Byte-level scans of the full history found NO real key in git (the old
# start_backend.bat leak was cleaned to ***REMOVED*** placeholders before
# the public-release rewrite, and .env.local has never been tracked). This
# hook makes sure it STAYS that way: staged content matching known
# credential shapes blocks the commit until the secret is removed.
#
# Install: git config core.hooksPath .githooks  (done in this repo)

set -e

# The guard itself is exempt: its regex literals (the very patterns it
# blocks) must be committable, or the hook can never be updated.
if [ "$(git diff --cached --name-only | grep -vcE '^\.githooks/')" = "0" ]; then
  exit 0
fi

# Credential shapes, one per line. Kept conservative to avoid false
# positives; the DB-URL class covers embedded passwords without shell
# metacharacters in the class (no '!' — history expansion in some sh).
staged=$(git diff --cached --no-color -U0 | grep -aE '^\+' | grep -avE '^\+\+\+' || true)

if [ -n "$staged" ]; then
  if printf '%s\n' "$staged" | grep -aEnq -e '(sk|pk)-test_[A-Za-z0-9_-]{25,}' \
      -e 'sk-[A-Za-z0-9]{32,}' \
      -e 'tvly-dev-[A-Za-z0-9-]{30,}' \
      -e 'GLM_API_KEY=[A-Za-z0-9][A-Za-z0-9]{15,}' \
      -e 'TAVILY_API_KEY=tvly-[A-Za-z0-9-]{10,}' \
      -e 'CLERK_SECRET_KEY=[A-Za-z0-9_-]{20,}' \
      -e 'postgres(ql)?://[A-Za-z0-9_]+:[A-Za-z0-9_#%^&*-]{8,}@'; then
    echo "pre-commit: credential-like content staged — commit BLOCKED" >&2
    echo "" >&2
    echo "  Matched: live API keys (GLM/Tavily/Clerk secrets), long bearer" >&2
    echo "  tokens, or DB URLs with embedded passwords." >&2
    echo "" >&2
    echo "  Secrets belong in .env.local (never tracked). For a reviewed" >&2
    echo "  false positive bypass ONCE with: git commit --no-verify" >&2
    echo "" >&2
    echo "  Offending staged lines (truncated):" >&2
    printf '%s\n' "$staged" | grep -aEn -e '(sk|pk)-test_[A-Za-z0-9_-]{25,}' \
      -e 'sk-[A-Za-z0-9]{32,}' \
      -e 'tvly-dev-[A-Za-z0-9-]{30,}' \
      -e 'GLM_API_KEY=[A-Za-z0-9][A-Za-z0-9]{15,}' \
      -e 'TAVILY_API_KEY=tvly-[A-Za-z0-9-]{10,}' \
      -e 'CLERK_SECRET_KEY=[A-Za-z0-9_-]{20,}' \
      -e 'postgres(ql)?://[A-Za-z0-9_]+:[A-Za-z0-9_#%^&*-]{8,}@' | cut -c1-120 | head -5 >&2
    exit 1
  fi
fi

exit 0
